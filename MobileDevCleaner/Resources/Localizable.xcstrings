    "%@ no arrancará hasta volver a descargarla (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ won't start until you download it again (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は再ダウンロードするまで起動しません（%@）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要重新下载后才能启动（%@）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não vai iniciar até você baixar de novo (%@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ startet erst, wenn du es erneut herunterlädst (%@)."
          }
        }
      }
    },
