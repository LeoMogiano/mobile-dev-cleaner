    " que Xcode y Gradle regeneran solos cuando los necesites." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " that Xcode and Gradle regenerate on their own when you need them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " XcodeとGradleが必要なときに自動で再生成します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 需要时 Xcode 和 Gradle 会自动重新生成。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "que o Xcode e o Gradle recriam sozinhos quando você precisar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", die Xcode und Gradle bei Bedarf von selbst neu erzeugen."
          }
        }
      }
    },
