    "Depende de la acción: limpiar conserva tus apps; restablecer o eliminar las borra." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It depends on the action: clean keeps your apps; reset or delete removes them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作によって異なります。クリーンアップではアプリは残りますが、リセットや削除ではアプリが消えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取决于所选操作：清理会保留你的应用；重置或删除则会将其移除。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depende da ação: limpar mantém seus apps; redefinir ou excluir os remove."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je nach Aktion: Bereinigen behält deine Apps; Zurücksetzen oder Löschen entfernt sie."
          }
        }
      }
