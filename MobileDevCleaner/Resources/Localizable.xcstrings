    "Pierdes los ajustes de esa versión. Tu versión actual no se toca." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You lose that version's settings. Your current version is untouched."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのバージョンの設定が失われます。現在のバージョンには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会失去该版本的设置。当前版本不受影响。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você perde os ajustes dessa versão. Sua versão atual não é alterada."
