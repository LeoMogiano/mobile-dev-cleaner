            "value" : "%@, %@"
          }
        }
      }
    },
    "%@: quedará como recién creado. Se pierden sus apps y datos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: will be reset to new. You'll lose your apps and data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 新規作成直後の状態に戻ります。アプリとデータは失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：将恢复为刚创建时的状态。其中的应用和数据会丢失。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: vai voltar ao estado de recém-criado. Você perde os apps e os dados."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: wird auf den Neuzustand zurückgesetzt. Apps und Daten gehen verloren."
          }
        }
      }
    },
    "%@: se borra el dispositivo completo. Podrás crearlo de nuevo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: the device will be erased completely. You can create it again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: デバイス全体が消去されます。後で再作成できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：将完全清除该设备。之后可以重新创建。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: o dispositivo inteiro será apagado. Você poderá criá-lo de novo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: das Gerät wird vollständig gelöscht. Du kannst es danach neu erstellen."
          }
        }
      }
    },
