    "Limpiar conserva tus apps; restablecer o eliminar las borra." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean keeps your apps; reset or delete removes them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリーンアップではアプリは残ります。リセットや削除ではアプリが消えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清理会保留你的应用；重置或删除则会将其移除。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar mantém seus apps; redefinir ou excluir os remove."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereinigen behält deine Apps; Zurücksetzen oder Löschen entfernt sie."
          }
        }
      }
    },
    "Limpiar mientras están abiertas puede corromper builds en curso o datos de un simulador." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cleaning while open can corrupt builds in progress or simulator data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いたままクリーンアップすると、進行中のビルドやシミュレータのデータが壊れることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在打开状态下清理，可能会破坏正在进行的构建或模拟器数据。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar enquanto estão abertos pode corromper builds em andamento ou dados de um simulador."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereinigen, während sie geöffnet sind, kann laufende Builds oder Simulator-Daten beschädigen."
          }
        }
      }
    },
