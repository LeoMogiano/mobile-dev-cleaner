    "Liquid Glass usa vidrio translúcido de macOS Tahoe. Clásico es el estilo de Sonoma y Sequoia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass uses translucent glass from macOS Tahoe. Classic is the style from Sonoma and Sequoia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass は macOS Tahoe の半透明のガラス表現を使います。クラシックは Sonoma と Sequoia のスタイルです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass 使用 macOS Tahoe 的半透明玻璃效果。经典是 Sonoma 和 Sequoia 的风格。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Liquid Glass usa vidro translúcido do macOS Tahoe. Clássico é o estilo do Sonoma e do Sequoia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass nutzt das durchscheinende Glas von macOS Tahoe. Klassisch ist der Stil von Sonoma und Sequoia."
          }
        }
      }
    },
