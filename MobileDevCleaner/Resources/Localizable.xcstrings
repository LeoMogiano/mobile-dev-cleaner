    "Nunca se marcarán, ni siquiera en la limpieza recomendada. Útil para el proyecto en el que trabajas a diario." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They'll never be checked, not even in recommended cleanup. Useful for your daily project."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おすすめのクリーンアップでもチェックされることはありません。毎日使うプロジェクトを守るのに便利です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使在推荐清理中也不会被勾选。适合保护你每天使用的项目。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca serão marcados, nem na limpeza recomendada. Útil para o projeto em que você trabalha todos os dias."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden nie markiert, auch nicht bei der empfohlenen Bereinigung. Nützlich für das Projekt, an dem du täglich arbeitest."
          }
        }
      }
    },
