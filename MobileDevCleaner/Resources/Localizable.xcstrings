        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verlierst die Einstellungen dieser Version. Deine aktuelle Version bleibt unverändert."
          }
        }
      }
    },
    "Pierdes los ajustes y plugins de %@. Tu versión actual no cambia." : {
