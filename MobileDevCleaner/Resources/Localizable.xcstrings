    "¿Qué es y qué pasa si lo borro?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is it and what happens if I delete it?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは何で、削除するとどうなりますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是什么？删除后会怎样？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que é e o que acontece se eu excluir?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist das, und was passiert, wenn ich es lösche?"
          }
        }
      }
    },
